# Database (Neon / Supabase / any PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/expense_tracker?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/expense_tracker?sslmode=require"

# Auth.js (generate: openssl rand -base64 32)
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# OAuth Providers (optional — app works with email/password too)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Stripe (for subscriptions — wired but not activated)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ExpenseTrack"
